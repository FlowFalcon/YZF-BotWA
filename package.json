{
  "name": "yzf-botwa",
  "version": "0.0.1",
  "description": "Base bot WhatsApp modular berbasis TypeScript dan zapo-js.",
  "license": "MIT",
  "private": true,
  "author": "FlowFalcon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlowFalcon/YZF-BotWA.git"
  },
  "bugs": {
    "url": "https://github.com/FlowFalcon/YZF-BotWA/issues"
  },
  "homepage": "https://github.com/FlowFalcon/YZF-BotWA#readme",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env app/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/app/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@zapo-js/store-sqlite": "1.2.0",
    "better-sqlite3": "13.0.3",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0",
    "sharp": "0.35.4",
    "zapo-js": "1.8.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/qrcode-terminal": "0.12.2",
    "@vitest/coverage-v8": "4.1.11",
    "@zapo-js/fake-server": "1.3.0",
    "@zapo-js/mcp-server": "1.2.0",
    "eslint": "10.9.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
