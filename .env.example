# Prefix command, dipisahkan koma. Default: .
BOT_PREFIXES=.

# Nomor owner, digit dengan country code. WAJIB: mode private menolak semua
# private chat bila kosong, dan grup hanya bisa di-allowlist oleh owner.
BOT_OWNER_NUMBER=

# auto | qr | pairing
BOT_AUTH_METHOD=auto

# Wajib bila BOT_AUTH_METHOD=pairing dan proses berjalan noninteraktif.
BOT_PAIRING_NUMBER=

# Jangan diubah setelah pairing berhasil.
BOT_SESSION_ID=default

# Lokasi SQLite protocol store. Allowlist grup disimpan di direktori yang sama
# (allowed-groups.json), dikelola lewat command .access — bukan lewat env.
BOT_STORE_PATH=.auth/state.sqlite

# trace | debug | info | warn | error
BOT_LOG_LEVEL=info

NODE_ENV=development
