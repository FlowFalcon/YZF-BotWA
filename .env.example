# Prefix command, dipisahkan koma. Default: .
BOT_PREFIXES=.

# Nomor owner, digit dengan country code. Wajib untuk command owner dan jalur
# kontrol darurat pada mode group-only/owner-only.
BOT_OWNER_NUMBER=

# auto | qr | pairing
BOT_AUTH_METHOD=auto

# Wajib bila BOT_AUTH_METHOD=pairing dan proses berjalan noninteraktif.
BOT_PAIRING_NUMBER=

# Jangan diubah setelah pairing berhasil.
BOT_SESSION_ID=default

# Lokasi SQLite protocol store. Settings runtime disimpan atomik sebagai
# settings.json di direktori yang sama (default: .auth/settings.json).
BOT_STORE_PATH=.auth/state.sqlite

# trace | debug | info | warn | error
BOT_LOG_LEVEL=info

NODE_ENV=development
